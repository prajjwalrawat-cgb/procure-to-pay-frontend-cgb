{
  "name": "ProcureFlow Scanner",
  "short_name": "Scanner",
  "description": "Warehouse scanning: receive, putaway, pick, count and transfer stock from a handset.",
  "start_url": "/scan",
  "_comment_scope": "'/' not '/scan': sign-out goes to /login, and an out-of-scope URL opens in a browser tab, stranding the operator outside the installed app. The service worker is still registered at scope /scan, so only the scanner is cached.",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0f172a",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/icons/scanner-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/scanner-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/scanner-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
