{
  "id": "/vendor",
  "name": "ProcureFlow Supplier Portal",
  "short_name": "Supplier Portal",
  "description": "Your purchase orders, invoices, payments and documents with your ProcureFlow customers.",
  "start_url": "/vendor",
  "_comment_scope": "'/' so sign-in (/login, /vendor/login) stays inside the installed window instead of opening a browser tab.",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#FAF9F6",
  "theme_color": "#FFFFFF",
  "categories": [
    "business",
    "finance",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/app-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
