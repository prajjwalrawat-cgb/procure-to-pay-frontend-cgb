{
  "id": "/",
  "name": "ProcureFlow",
  "short_name": "ProcureFlow",
  "description": "Procure-to-pay for Indian manufacturing: requisitions, POs, receipts, invoices and payments.",
  "start_url": "/",
  "_comment_scope": "'/' so sign-in (/login, /vendor/login) stays inside the installed window instead of opening a browser tab.",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#F6F4EE",
  "theme_color": "#FFFFFF",
  "categories": [
    "business",
    "finance",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/app-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
