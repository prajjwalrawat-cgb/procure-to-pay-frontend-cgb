# =============================================================================
# ProcureFlow FRONTEND — environment template.
# On Vercel, set these per project (web / vendor) as Environment Variables.
# The frontend calls the backend API cross-origin; it never touches the DB.
# =============================================================================

# --- Web (buyer portal) — Vercel project root: apps/web ---
# Browser-facing API base = the deployed backend (Railway) API. In local dev,
# point at your local API (http://localhost:3001/api/v1) or the Railway URL.
NEXT_PUBLIC_API_URL=https://<api>.up.railway.app/api/v1
WEB_PORT=3000
# Origin of the vendor deployment, for the /vendor multi-zone rewrite.
VENDOR_ZONE_URL=https://<vendor>.vercel.app

# --- Vendor portal — Vercel project root: apps/vendor ---
NEXT_PUBLIC_VENDOR_API_URL=https://<api>.up.railway.app/api/v1
VENDOR_PORT=3002

# Only needed if you run the local single-origin proxy (pnpm dev on one port):
# API_INTERNAL_URL=http://localhost:3001/api/v1
