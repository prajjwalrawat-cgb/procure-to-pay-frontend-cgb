# =============================================================================
# ProcureFlow FRONTEND — environment variables (single Next.js app, deploy to
# Vercel). Set these in the Vercel project's Environment Variables (Production
# + Preview). This app talks to the backend API through a same-origin /api/v1
# proxy and never touches the database, so NO DB / JWT / S3 / SMTP secrets
# belong here — those live in the backend repo.
# =============================================================================

# REQUIRED — absolute base URL of the deployed backend API (server-side only).
# Used by the /api/v1 rewrite proxy (next.config.mjs) and the auth route
# handlers (/api/auth/*, /api/vendor/auth/*). Example (Railway):
API_INTERNAL_URL=https://<your-backend-host>/api/v1

# OPTIONAL — browser-facing API bases. Keep as '/api/v1' so the browser calls
# the backend same-origin through the proxy above (recommended — no CORS).
# Only set to an absolute backend URL if you want the browser to hit the API
# directly (you must then enable CORS on the backend for the Vercel origin).
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_VENDOR_API_URL=/api/v1

# LOCAL E2E ONLY — Playwright base URL (defaults to http://localhost:3000).
# Not needed on Vercel.
# WEB_BASE_URL=http://localhost:3000
